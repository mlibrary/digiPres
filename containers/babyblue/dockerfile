# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.14.7-alpine3.24

# ------------------------------------------------------------
# Builder
# ------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY requirements.txt /build/requirements.txt

RUN echo "Working directory: $(pwd)" \
    && ls -la /build \
    && sha256sum /build/requirements.txt \
    && test -s /build/requirements.txt

RUN python -m pip install --upgrade \
        pip \
        wheel \
        "setuptools>=78.1.1" \
    && python -m pip wheel \
        --wheel-dir=/build/wheels \
        --requirement=/build/requirements.txt

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=globus_portal_framework.settings \
    HOME=/tmp

ARG REQUIREMENTS_SHA
LABEL org.example.requirements-sha="${REQUIREMENTS_SHA}"

# Alpine security updates. Do not use apt-get in an Alpine image.
RUN apk upgrade --no-cache

COPY --from=builder /build/wheels /tmp/wheels
COPY --from=builder /build/requirements.txt /tmp/requirements.txt

RUN python -m pip install \
        --no-index \
        --find-links=/tmp/wheels \
        --requirement=/tmp/requirements.txt \
    && python -m pip check \
        && python -m pip uninstall --yes setuptools wheel \
    && python -m pip uninstall --yes pip \
    && rm -rf \
        /tmp/wheels \
        /tmp/requirements.txt \
        /root/.cache

WORKDIR /app

# Numeric ownership avoids useradd/adduser and supports OpenShift.
COPY --chown=1001:0 . /app

# OpenShift arbitrary UIDs generally receive group 0 permissions.
RUN chgrp -R 0 /app \
    && chmod -R g=u /app

USER 1001

EXPOSE 8000

CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=3", "globus_portal_framework.wsgi:application"]
