# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.14-alpine

# ------------------------------------------------------------
# Builder
# ------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Install security updates and tools required to compile Python packages.
# Depending on requirements.txt, additional *-dev packages may be needed.
RUN apk upgrade --no-cache \
    && apk add --no-cache \
        build-base \
        libffi-dev \
        openssl-dev

COPY requirements.txt .

RUN python -m pip install --upgrade pip \
    && python -m pip wheel \
        --wheel-dir=/build/wheels \
        --requirement=requirements.txt


# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=globus_portal_framework.settings \
    HOME=/tmp

# Alpine security updates. Do not use apt-get in an Alpine image.
RUN apk upgrade --no-cache

COPY --from=builder /build/wheels /tmp/wheels
COPY --from=builder /build/requirements.txt /tmp/requirements.txt

RUN python -m pip install \
        --no-index \
        --find-links=/tmp/wheels \
        --requirement=/tmp/requirements.txt \
    && rm -rf /tmp/wheels /tmp/requirements.txt

WORKDIR /app

# Numeric ownership avoids useradd/adduser and supports OpenShift.
COPY --chown=1001:0 . /app

# OpenShift arbitrary UIDs generally receive group 0 permissions.
RUN chgrp -R 0 /app \
    && chmod -R g=u /app

USER 1001

EXPOSE 8000

CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=3", "globus_portal_framework.wsgi:application"]
